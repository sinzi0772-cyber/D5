rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function canManageAll() {
      return signedIn() && myProfile().role in ['admin', 'store_manager', 'assistant_manager'];
    }

    function canViewUsage() {
      return signedIn() && myProfile().role in ['admin', 'store_manager', 'assistant_manager', 'manager'];
    }

    function myEmployeeNo() {
      return myProfile().employeeNo;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canManageAll());
      allow create: if false;
      allow update: if signedIn() && (
        myProfile().role == 'admin'
        || (
          request.auth.uid == userId
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'mustChangePassword',
            'passwordChangedAt',
            'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    match /usage/{userId} {
      allow read: if canViewUsage();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.employeeNo == myProfile().employeeNo
        && request.resource.data.displayName == myProfile().displayName
        && request.resource.data.role == myProfile().role
        && request.resource.data.keys().hasOnly([
          'userId', 'employeeNo', 'displayName', 'role',
          'firstSeenAt', 'lastSeenAt', 'lastSeenDate', 'visitCount'
        ]);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.employeeNo == myProfile().employeeNo
        && request.resource.data.displayName == myProfile().displayName
        && request.resource.data.role == myProfile().role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'employeeNo', 'displayName', 'role',
          'lastSeenAt', 'lastSeenDate', 'visitCount'
        ]);
      allow delete: if false;
    }
    match /referrals/{referralId} {
      allow read: if signedIn()
        && (canManageAll() || resource.data.managerEmployeeNo == myEmployeeNo());

      allow create: if canManageAll()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if canManageAll()
        || (
          signedIn()
          && resource.data.managerEmployeeNo == myEmployeeNo()
          && request.resource.data.managerEmployeeNo == myEmployeeNo()
          && (
            !request.resource.data.keys().hasAny(['appointmentType'])
            || request.resource.data.appointmentType in ['미선택', '상담예약(이업종)', '이업종제휴']
          )
          && (
            !request.resource.data.keys().hasAny(['purchaseType'])
            || request.resource.data.purchaseType in ['미선택', '일시불', '구독', '일시불+구독']
          )
          && (
            !request.resource.data.keys().hasAny(['purchaseAmount'])
            || request.resource.data.purchaseAmount == null
            || (request.resource.data.purchaseAmount is number && request.resource.data.purchaseAmount >= 0)
          )
          && (
            !request.resource.data.keys().hasAny(['lumpSumAmount'])
            || request.resource.data.lumpSumAmount == null
            || (request.resource.data.lumpSumAmount is number && request.resource.data.lumpSumAmount >= 0)
          )
          && (
            !request.resource.data.keys().hasAny(['subscriptionAmount'])
            || request.resource.data.subscriptionAmount == null
            || (request.resource.data.subscriptionAmount is number && request.resource.data.subscriptionAmount >= 0)
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'visitScheduledDate',
            'appointmentType',
            'status',
            'visitState',
            'purchaseType',
            'purchaseAmount',
            'lumpSumAmount',
            'subscriptionAmount',
            'note',
            'memoHistory',
            'updatedAt',
            'updatedBy'
          ])
        );

      allow delete: if canManageAll();
    }
  }
}
