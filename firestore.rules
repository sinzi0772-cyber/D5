rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function canManageAll() {
      return signedIn() && myProfile().role in ['admin', 'store_manager', 'assistant_manager'];
    }

    function myEmployeeNo() {
      return myProfile().employeeNo;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canManageAll());
      allow create: if false;
      allow update: if signedIn() && myProfile().role == 'admin';
      allow delete: if false;
    }

    match /referrals/{referralId} {
      allow read: if signedIn()
        && (canManageAll() || resource.data.managerEmployeeNo == myEmployeeNo());

      allow create: if canManageAll()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if canManageAll()
        || (
          signedIn()
          && resource.data.managerEmployeeNo == myEmployeeNo()
          && request.resource.data.managerEmployeeNo == myEmployeeNo()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'visitScheduledDate',
            'status',
            'visitState',
            'note',
            'memoHistory',
            'updatedAt',
            'updatedBy'
          ])
        );

      allow delete: if canManageAll();
    }
  }
}
